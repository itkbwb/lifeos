# Python / server
server/.venv/
server/__pycache__/
server/app/__pycache__/
**/__pycache__/
*.pyc
server/uvicorn.*.log
server/backups/

# Real user data - never commit the live database
server/data/*.db
server/data/*.db-journal

# Android / Gradle
android/.gradle/
android/build/
android/*/build/
android/local.properties
android/.idea/
android/*.iml
android/captures/
*.apk
*.aab

# Firebase project config (chapter: notifications, server-pushed via FCM) -
# repo is public, this identifies the Firebase project. Placed locally by
# whoever sets up the project; CI gets it from a base64 secret instead.
android/app/google-services.json
server/firebase-service-account.json

# OS
.DS_Store
Thumbs.db

# Local-only handoff notes - repo is public, this can name internal
# hosts/IPs/topology that shouldn't be committed.
HANDOFF.md
